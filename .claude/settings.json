{
  "permissions": {
    "allow": [
      "Bash(codex exec:*)",
      "Bash(codex e:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec steiger:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test:e2e:*)",
      "Bash(pnpm exec playwright:*)",
      "Bash(pnpm dev:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git merge --no-commit --no-ff:*)",
      "Bash(git rebase main)"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hooks/session_end.py --tool claude"
          }
        ]
      }
    ]
  }
}
