# DART Open API (재무/공시 데이터)
DART_API_KEY=

# Supabase (DB + Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 스크래핑/이메일 수집 공고의 소유자 고정 (auth.users.id, uuid)
# 본인 Supabase 계정의 user_id를 여기 입력하면, 자동 수집한 공고가 본인 소유로 저장됨
SCRAPE_OWNER_USER_ID=

# 스크래핑 검색 범위 (콤마구분 키워드). role-filter 가 결과를 다시 거르므로 넓게 잡아도 됨.
# 권장: "프론트엔드,frontend,웹개발,퍼블리셔,풀스택,react,vue,개발자,웹,엔지니어"
SCRAPE_SEARCH_KEYWORDS=

# 키워드별 최대 페이지 수 (미설정 시 3 — 신규 공고만). 과거 백필은 수동 실행 시 SCRAPE_MAX_PAGES=10 등으로.
SCRAPE_MAX_PAGES=

# Gmail API (OAuth, 채용 알림 이메일 파싱 — 백업 채널)
# Testing 모드 + restricted 스코프는 refresh_token이 7일 후 만료되므로 주기적 갱신 필요
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost
GMAIL_REFRESH_TOKEN=

# 네이버 뉴스 검색 API (기업분석용 최신뉴스, 채용공고 수집용 아님)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Google Gemini API (기업분석 종합 LLM — 무료 티어)
# https://aistudio.google.com/apikey 에서 발급 (카드 불필요, 구글 계정만)
GEMINI_API_KEY=

# (예약, 현재 미사용) GHA 직접실행 방식으로는 보호할 HTTP 엔드포인트가 없으므로 미사용
CRON_SECRET=
