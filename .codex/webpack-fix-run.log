"use client";

import { Loader2, Plus } from "lucide-react";
import { useRouter } from "next/navigation";
import { useState, useTransition, type FormEvent } from "react";

import { EMPLOYMENT_TYPES, type EmploymentType } from "@/entities/job-posting";
import { Button } from "@/shared/ui/button";

import { submitJobPosting } from "../lib/submit.server";

const inputClassName =
  "h-10 w-full rounded-md border bg-background px-3 text-sm text-foreground outline-none transition-colors placeholder:text-muted-foreground focus:border-ring focus:ring-2 focus:ring-ring/20 disabled:cursor-not-allowed disabled:opacity-60";

const textareaClassName =
  "min-h-36 w-full rounded-md border bg-background px-3 py-2 text-sm leading-6 text-foreground outline-none transition-colors placeholder:text-muted-foreground focus:border-ring focus:ring-2 focus:ring-ring/20 disabled:cursor-not-allowed disabled:opacity-60";

type SubmitState = {
  error: string | null;
  success: string | null;
};

export function AddJobPostingForm() {
  const router = useRouter();
  const [isPending, startTransition] = useTransition();
  const [state, setState] = useState<SubmitState>({
    error: null,
    success: null
  });

  function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();

    const form = event.currentTarget;
    const formData = new FormData(form);
    const role = String(formData.get("role") ?? "");
    const employmentType = String(
      formData.get("employmentType") ?? "湲고?"
    ) as EmploymentType;

    startTransition(async () => {
      setState({ error: null, success: null });

      const result = await submitJobPosting({
        companyNameRaw: String(formData.get("companyNameRaw") ?? ""),
        role,
        employmentType,
        deadline: String(formData.get("deadline") ?? ""),
        url: String(formData.get("url") ?? ""),
        rawText: String(formData.get("rawText") ?? "")
      });

      if (!result.success) {
        setState({
          error: result.error ?? "怨듦퀬瑜???ν븯吏 紐삵뻽?듬땲??",
          success: null
        });
        return;
      }

      form.reset();
      setState({ error: null, success: "怨듦퀬瑜???ν뻽?듬땲??" });
      router.refresh();
    });
  }

  return (
    <form className="space-y-5" onSubmit={handleSubmit}>
      <div className="grid gap-4 sm:grid-cols-2">
        <label className="space-y-2 text-sm font-medium">
          <span>?뚯궗紐?/span>
          <input
            className={inputClassName}
            disabled={isPending}
            name="companyNameRaw"
            placeholder="?? ESTsoft"
          />
        </label>
        <label className="space-y-2 text-sm font-medium">
          <span>吏곷Т</span>
          <input
            className={inputClassName}
            disabled={isPending}
            name="role"
            placeholder="?? ?꾨줎?몄뿏??媛쒕컻??
            required
          />
        </label>
        <label className="space-y-2 text-sm font-medium">
          <span>怨좎슜?뺥깭</span>
          <select
            className={inputClassName}
            defaultValue="湲고?"
            disabled={isPending}
            name="employmentType"
          >
            {EMPLOYMENT_TYPES.map((type) => (
              <option key={type} value={type}>
                {type}
              </option>
            ))}
          </select>
        </label>
        <label className="space-y-2 text-sm font-medium">
          <span>留덇컧??/span>
          <input
            className={inputClassName}
            disabled={isPending}
            name="deadline"
            type="date"
          />
        </label>
      </div>

      <label className="block space-y-2 text-sm font-medium">
        <span>怨듦퀬 URL</span>
        <input
          className={inputClassName}
          disabled={isPending}
          name="url"
          placeholder="https://..."
          type="url"
        />
      </label>

      <label className="block space-y-2 text-sm font-medium">
        <span>怨듦퀬 蹂몃Ц</span>
        <textarea
          className={textareaClassName}
          disabled={isPending}
          name="rawText"
          placeholder="URL???녿떎硫?怨듦퀬 蹂몃Ц??遺숈뿬?ｌ쑝?몄슂."
        />
      </label>

      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p
          aria-live="polite"
          className="min-h-5 text-sm text-muted-foreground"
        >
          {state.error ? (
            <span className="text-destructive">{state.error}</span>
          ) : (
            state.success
          )}
        </p>
        <Button className="w-full sm:w-auto" disabled={isPending} type="submit">
          {isPending ? (
